{
  "name": "lift-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Local development and automated testing tools for Lift Operator.",
  "scripts": {
    "serve": "node tests/test-server.js",
    "test": "npm run test:full",
    "test:syntax": "node scripts/check-syntax.js",
    "docs:check": "node scripts/check-docs.js",
    "test:config": "node scripts/validate-config.js",
    "balance:generate": "node scripts/generate-balance.js",
    "balance:check": "node scripts/generate-balance.js --check",
    "test:economy": "node scripts/simulate-economy.js",
    "balance:acceptance": "node scripts/run-balance-acceptance.js",
    "balance:acceptance:strict": "node scripts/run-balance-acceptance.js --strict",
    "balance:acceptance:integrity": "node scripts/validate-balance-acceptance.js --integrity",
    "balance:acceptance:check": "node scripts/validate-balance-acceptance.js --strict",
    "balance:traces": "node scripts/analyze-balance-traces.js",
    "perf:capsule": "node scripts/capture-capsule-performance.js",
    "capture:media": "node scripts/capture-release-media.js",
    "package:itch": "powershell -ExecutionPolicy Bypass -File scripts/package-itch.ps1",
    "test:lifecycle": "playwright test tests/lifecycle-correctness.spec.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:mechanics": "playwright test tests/lifecycle-correctness.spec.js --grep \"patience|boarding|VIP|Gym|jam|stink|rooftop|Musak|Group Think|Open Plan\"",
    "test:integration": "playwright test tests/integration",
    "test:smoke": "npm run test:syntax && npm run docs:check && npm run test:config && npm run test:utf8 && playwright test tests/lifecycle-correctness.spec.js --grep \"retry|canonical|countdown|automation bridge\"",
    "test:full": "npm run test:syntax && npm run docs:check && npm run test:config && npm run balance:check && npm run balance:acceptance:integrity && npm run test:economy && npm run test:utf8 && npm run test:unit && npm run test:mechanics && npm run test:integration && playwright test",
    "test:release": "npm run test:full && npm run balance:acceptance && npm run balance:acceptance:integrity",
    "test:utf8": "node scripts/validate-utf8.js",
    "human:protocol": "node scripts/validate-human-protocol.js"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "lz-string": "1.5.0"
  }
}
